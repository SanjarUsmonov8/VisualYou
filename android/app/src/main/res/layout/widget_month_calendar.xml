<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical">
    <TextView android:id="@+id/calendar_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Performance calendar" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/calendar_month" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:gravity="center" android:textColor="@color/widget_text"
        android:textSize="14sp" android:textStyle="bold" />
    <ImageView android:id="@+id/calendar_grid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:adjustViewBounds="true" android:contentDescription="@string/main_calendar_widget_description"
        android:scaleType="fitCenter" />
</LinearLayout>
