<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gradual reduction"
        android:textColor="@color/widget_text" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/reduction_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:text="Create a plan in the app" android:textColor="@color/widget_text_muted" android:textSize="12sp" />
    <TextView android:id="@+id/reduction_grid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fontFamily="monospace" android:gravity="center" android:includeFontPadding="false"
        android:lineSpacingExtra="1dp" android:textColor="@color/widget_text_muted" android:textSize="10sp" />
    <TextView android:id="@+id/reduction_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="7dp" android:text="Today is not tracked" android:textColor="@color/widget_text_muted" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
        <TextView android:id="@+id/reduction_avoided" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/widget_action_background"
            android:gravity="center" android:text="Avoided ✓" android:textColor="@color/widget_text" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/reduction_did" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/widget_action_background"
            android:gravity="center" android:text="Did it" android:textColor="@color/widget_text" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
