DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^http://(localhost|127\.0\.0\.1)(:\d+)?$
DJANGO_CORS_ALLOW_PRIVATE_NETWORK=True

POSTGRES_DB=visualyou
POSTGRES_USER=visualyou
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Keep the console backend during local development. Verification emails will
# appear in the terminal running Django. Configure SMTP for real delivery.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Visual You <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_SIGNUP_CODE_TTL_MINUTES=10

# Generate a private replacement key in Google AI Studio. Never commit the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=700
GEMINI_HISTORY_MESSAGE_LIMIT=20
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608
